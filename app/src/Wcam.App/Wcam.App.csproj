<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>WCam</AssemblyName>
    <RootNamespace>Wcam.App</RootNamespace>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
    <PublishTrimmed>true</PublishTrimmed>
    <IsAotCompatible>true</IsAotCompatible>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <CsWin32RunAsBuildTask>true</CsWin32RunAsBuildTask>
    <SatelliteResourceLanguages>en;pt-BR</SatelliteResourceLanguages>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.7.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.7.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.371" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\..\vcam\src\Wcam.VirtualCamera\FrameChannel.cs" Link="VirtualCamera\FrameChannel.cs" />
    <Compile Include="..\..\..\vcam\src\Wcam.VirtualCamera\FrameFormat.cs" Link="VirtualCamera\FrameFormat.cs" />
    <Compile Include="..\..\..\vcam\src\Wcam.VirtualCamera\FrameTransport.cs" Link="VirtualCamera\FrameTransport.cs" />
    <Compile Include="..\..\..\vcam\src\Wcam.VirtualCamera\VideoFormat.cs" Link="VirtualCamera\VideoFormat.cs" />
  </ItemGroup>
</Project>
